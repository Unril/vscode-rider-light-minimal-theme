{
  "name": "vscode-rider-light-minimal-theme",
  "displayName": "Rider Light Minimal",
  "description": "Light and dark color themes for VS Code. Consistent syntax highlighting across languages with a themed markdown preview style. Inspired by JetBrains Rider.",
  "version": "0.4.0",
  "publisher": "NikolaiFedorov",
  "repository": {
    "type": "git",
    "url": "https://github.com/Unril/vscode-rider-light-minimal-theme"
  },
  "bugs": {
    "url": "https://github.com/Unril/vscode-rider-light-minimal-theme/issues"
  },
  "homepage": "https://github.com/Unril/vscode-rider-light-minimal-theme",
  "license": "MIT",
  "icon": "img/icon.png",
  "galleryBanner": {
    "color": "#F2F2F2",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Themes"
  ],
  "main": "./src/extension.js",
  "browser": "./src/extension.js",
  "activationEvents": [],
  "extensionDependencies": [
    "vscode.markdown-language-features"
  ],
  "keywords": [
    "theme",
    "light",
    "dark",
    "color-theme",
    "rider",
    "jetbrains",
    "kotlin",
    "csharp",
    "basedpyright",
    "markdown-preview",
    "markdown-style",
    "markdown-theme",
    "syntax-highlighting"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./styles/markdown-variables.css",
      "./styles/markdown-preview.css",
      "./styles/markdown-highlight.css"
    ],
    "configuration": {
      "title": "Rider Light Minimal",
      "properties": {
        "rider-light-minimal.markdownPreview.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Apply Rider Light Minimal styling to the Markdown preview. Disable to use the default VS Code preview style."
        }
      }
    },
    "themes": [
      {
        "label": "Rider Light Minimal",
        "uiTheme": "vs",
        "path": "./themes/Rider Light Minimal-color-theme.json"
      },
      {
        "label": "Rider Light Minimal Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/Rider Light Minimal Dark-color-theme.json"
      }
    ]
  },
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
